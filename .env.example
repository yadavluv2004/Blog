# Copy to .env.local and fill in.

# MongoDB connection string. Posts are stored here and managed from /admin.
# Without this set, the site still builds and runs — every content section
# just shows its empty state, and /admin shows "not configured yet".
MONGODB_URI=
MONGODB_DB=blog

# Login password for /admin. Anyone with this password can create, edit
# and delete posts — treat it like any other credential.
ADMIN_PASSWORD=

# Signs the /admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Canonical site URL, used for sitemap, robots and Open Graph absolute URLs.
NEXT_PUBLIC_SITE_URL=

# Newsletter provider endpoint (Buttondown, ConvertKit, Mailchimp, ...).
# Until this is set, the newsletter form stays disabled and says so.
NEWSLETTER_ENDPOINT=
